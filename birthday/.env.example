# Copy to .env (never commit .env) and fill in.
NUCLEUS_URL=
NUCLEUS_KEY=
# Header used for the key. Examples: Authorization + "Bearer "  |  X-API-Key + (empty prefix)
NUCLEUS_AUTH_HEADER=Authorization
NUCLEUS_AUTH_PREFIX=Bearer 
# If the staff array is nested in the response, e.g. data.staff
NUCLEUS_LIST_PATH=
# Names of the fields in Nucleus' JSON
FIELD_NAME=name
FIELD_DOB=dob
FIELD_ROLE=designation
FIELD_PHOTO=photo
DOB_FORMAT=%Y-%m-%d
# If photo is a relative path, the prefix to add; set PHOTO_NEEDS_KEY=1 if photo URLs need the key
PHOTO_BASE=
PHOTO_NEEDS_KEY=0
